{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/client",
    "src/catalog-groups.ts",
    "src/compact-preview.ts",
    "src/context-panel-ui.ts",
    "src/fixes-settings.ts"
  ]
}
